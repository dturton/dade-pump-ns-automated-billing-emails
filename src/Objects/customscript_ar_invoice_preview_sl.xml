  <name>AR Invoice Sender Preview</name>
  <notifyadmins>F</notifyadmins>
  <notifyowner>T</notifyowner>
  <scriptfile>[/SuiteScripts/ar-invoice-sender/ar_invoice_preview_sl.js]</scriptfile>
  <scriptdeployments>
    <scriptdeployment scriptid="customdeploy_ar_invoice_preview_sl">
      <allemployees>F</allemployees>
      <allpartners>F</allpartners>
      <allroles>F</allroles>
      <audslctrole>ADMINISTRATOR|ACCOUNTANT|AR_CLERK</audslctrole>
      <isdeployed>T</isdeployed>
      <isonline>F</isonline>
      <loglevel>ERROR</loglevel>
